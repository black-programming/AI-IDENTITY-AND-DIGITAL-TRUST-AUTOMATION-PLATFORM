# ==============================================================================
# Flutter Web Frontend Environment Variables
# CRITICAL: ONLY ANONYMOUS/PUBLIC KEYS ARE PERMITTED HERE.
# NEVER ADD SUPABASE_SERVICE_ROLE_KEY TO THIS FILE OR FLUTTER BUILDS.
# ==============================================================================

# Supabase URL & Public Anonymous Key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Endpoint
BACKEND_API_BASE_URL=http://localhost:8000/api/v1
