# Backend Environment Variables Template
ENVIRONMENT=development
LOG_LEVEL=INFO

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8000"]

# Supabase Server-Side Settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars

# Storage & Signing
STORAGE_BUCKET_QUARANTINE=evidence-quarantine
STORAGE_BUCKET_VERIFIED=evidence-verified
SIGNED_URL_EXPIRY_SECONDS=900
