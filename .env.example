# ==============================================================================
# AI Identity & Digital Trust Automation Platform - Environment Variables Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# FastAPI Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8000"]

# Supabase Configuration
# Server-side service_role key MUST remain in backend only. NEVER expose to client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-at-least-32-chars-long

# Storage Buckets
STORAGE_BUCKET_QUARANTINE=evidence-quarantine
STORAGE_BUCKET_VERIFIED=evidence-verified
SIGNED_URL_EXPIRY_SECONDS=900

# OCR & Pipeline
OCR_ENGINE=PaddleOCR
OCR_CONFIDENCE_THRESHOLD=0.85
MAX_UPLOAD_SIZE_BYTES=10485760
